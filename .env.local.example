# =============================================================================
# .env.local.example — lease-demo
#
# Template ONLY. Do NOT put real key material in this file.
#
# scripts/lib/local-crypto-keys.sh generates the actual .env.local file
# automatically (once) the first time you run scripts/deploy-local.sh or
# scripts/postgres-seed-local-data.sh. You normally do NOT need to create
# .env.local by hand.
#
# .env.local is gitignored and must never be committed.
# =============================================================================

CRYPTO_AES_KEY=<Base64-encoded 32-byte AES-256 key — generate with: openssl rand -base64 32>
CRYPTO_HMAC_KEY=<Base64-encoded 32-byte HMAC key — generate with: openssl rand -base64 32>
